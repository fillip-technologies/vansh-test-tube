RewriteEngine On

# Root URL -> Vite production build
RewriteRule ^$ dist/index.html [L]

# Vite assets
RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

# Images
RewriteRule ^images/(.*)$ dist/images/$1 [L]

# Public files
RewriteRule ^(favicon\.ico|apple-touch-icon\.png|icon-192\.png|icon-512\.png|robots\.txt|site\.webmanifest)$ dist/$1 [L]

# React Router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ dist/index.html [L]